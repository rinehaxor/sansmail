        .inbox-card {
            padding: 0;
            overflow: hidden;
        }
        .inbox-header {
            padding: 1.5rem 2rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .inbox-header h2 {
            font-size: 1.25rem;
            font-weight: 600;
        }
        .badge {
            background-color: rgba(59, 130, 246, 0.1);
            color: var(--primary);
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.875rem;
            font-weight: 600;
        }

        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
        }
        .empty-icon {
            margin-bottom: 1rem;
            color: var(--border-color);
        }
        .empty-state h3 {
            font-size: 1.125rem;
            font-weight: 500;
            color: var(--text-main);
            margin-bottom: 0.5rem;
        }
        .empty-state p {
            color: var(--text-muted);
            font-size: 0.875rem;
        }

        .emails {
            display: flex;
            flex-direction: column;
        }
        .email-item {
            padding: 1.5rem 2rem;
            border-bottom: 1px solid var(--border-color);
        }
        .email-item:last-child {
            border-bottom: none;
