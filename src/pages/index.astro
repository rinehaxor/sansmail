            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .avatar {
            width: 32px;
            height: 32px;
            background-color: var(--primary);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.875rem;
        }
        .sender {
            font-weight: 500;
            font-size: 0.95rem;
        }
        .time {
            font-size: 0.875rem;
            color: var(--text-muted);
        }
        .subject {
            font-size: 1.125rem;
            font-weight: 600;
            margin-bottom: 0.75rem;
            color: var(--text-main);
        }
        .body-content {
            font-size: 0.95rem;
            line-height: 1.6;
            color: var(--text-muted);
            background-color: var(--bg-base);
            border-radius: 8px;
            border: 1px solid var(--border-color);
            overflow: hidden;
        }
        .email-iframe {
            width: 100%;
            min-height: 200px;
            max-height: 400px;
            border: none;
            display: block;
            background: #fff;
            border-radius: 8px;
        }
        .body-pre {
            padding: 1.25rem;
            margin: 0;
            white-space: pre-wrap;
            word-break: break-word;
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            max-height: 300px;
            overflow-y: auto;
        }
        .no-content {
            display: block;
            padding: 1.25rem;
            color: var(--text-muted);
            font-style: italic;
        }
    </style>

    <style is:global>
        .emails {
            display: flex;
            flex-direction: column;
        }
        .email-item {
            padding: 1.5rem 2rem;
            border-bottom: 1px solid var(--border-color);
        }
        .email-item:last-child {
            border-bottom: none;
        }
        .email-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }
        .sender-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .avatar {
            width: 32px;
            height: 32px;
            min-width: 32px;
            background-color: var(--primary);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.875rem;
        }
        .sender {
            font-weight: 500;
            font-size: 0.875rem;
            color: var(--text-muted);
            word-break: break-all;
        }
        .time {
            font-size: 0.875rem;
            color: var(--text-muted);
            white-space: nowrap;
            margin-left: 1rem;
        }
        .subject {
            font-size: 1.125rem;
            font-weight: 600;
            margin-bottom: 0.75rem;
            color: var(--text-main);
        }
        .body-content {
            font-size: 0.95rem;
            line-height: 1.6;
            color: var(--text-muted);
            background-color: var(--bg-base);
            border-radius: 8px;
            border: 1px solid var(--border-color);
            overflow: hidden;
        }
        .email-iframe {
            width: 100%;
            min-height: 180px;
            max-height: 400px;
            border: none;
            display: block;
            background: #fff;
        }
        .body-pre {
            padding: 1.25rem;
            margin: 0;
            white-space: pre-wrap;
            word-break: break-word;
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
            max-height: 300px;
            overflow-y: auto;
            color: var(--text-muted);
        }
        .no-content {
            display: block;
            padding: 1.25rem;
            color: var(--text-muted);
            font-style: italic;
        }
        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
            color: var(--text-muted);
        }
        .empty-state h3 {
            font-size: 1.125rem;
            font-weight: 500;
            color: var(--text-main);
            margin: 1rem 0 0.5rem;
        }
    </style>

    <script>
        const btn = document.getElementById('copy-btn');
        const emailSpan = document.getElementById('email-address');
        const originalBtnHTML = btn ? btn.innerHTML : '';
        
        if(btn && emailSpan) {
            btn.addEventListener('click', () => {
                navigator.clipboard.writeText(emailSpan.innerText);
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied!`;
                btn.style.backgroundColor = '#10b981'; // Green
                setTimeout(() => { 
                    btn.innerHTML = originalBtnHTML; 
                    btn.style.backgroundColor = '';
                }, 2000);
            });
        }

        // ── AJAX Polling: hanya update inbox, bukan reload halaman ──
        const inboxId = new URLSearchParams(window.location.search).get('id');
        const emailListContainer = document.querySelector('.email-list') as HTMLElement;
        const badgeEl = document.querySelector('.badge') as HTMLElement;

        function timeAgo(dateStr: string): string {
            const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
            if (diff < 60) return 'Just now';
            if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
            return `${Math.floor(diff / 3600)}h ago`;
        }

        function renderEmails(emailData: any[]) {
            badgeEl.textContent = String(emailData.length);
            if (emailData.length === 0) {
                emailListContainer.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--border-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                        </div>
                        <h3>Your inbox is empty</h3>
                        <p>Waiting for incoming messages</p>
                    </div>`;
                return;
            }
            emailListContainer.innerHTML = `<div class="emails">${emailData.map(msg => {
                const initial = (msg.sender || '?').charAt(0).toUpperCase();
                const sender = msg.sender || 'Unknown';
                const subject = msg.subject || '(No Subject)';
                const body = msg.htmlBody
                    ? `<iframe class="email-iframe" srcdoc="${msg.htmlBody.replace(/"/g, '&quot;')}" sandbox="allow-same-origin" scrolling="auto"></iframe>`
                    : msg.textBody
                    ? `<pre class="body-pre">${msg.textBody}</pre>`
                    : '<span class="no-content">No content.</span>';
                const time = timeAgo(msg.receivedAt || msg.received_at || '');
                return `
                    <div class="email-item">
                        <div class="email-meta">
                            <div class="sender-info">
                                <div class="avatar">${initial}</div>
                                <span class="sender">${sender}</span>
                            </div>
                            <span class="time">${time}</span>
                        </div>
                        <h3 class="subject">${subject}</h3>
                        <div class="body-content">${body}</div>
                    </div>`;
            }).join('')}</div>`;
        }

        let lastCount = -1;
        async function pollInbox() {
            try {
                const res = await fetch(`/api/inbox/emails?id=${inboxId}`);
                if (!res.ok) return;
                const data = await res.json();
                if (data.emails.length !== lastCount) {
                    lastCount = data.emails.length;
                    renderEmails(data.emails);
                }
            } catch {}
        }

        pollInbox();
        setInterval(pollInbox, 5000);

        // ── Custom Email Modal ──
        const domains: string[] = JSON.parse(
            document.getElementById('domains-data')?.textContent || '[]'
        );

        const domainSelect = document.getElementById('custom-domain') as HTMLSelectElement;
        domains.forEach(d => {
            const opt = document.createElement('option');
            opt.value = d;
            opt.textContent = d;
            domainSelect.appendChild(opt);
        });

        const modal = document.getElementById('custom-modal')!;
        const customBtn = document.getElementById('custom-email-btn')!;
        const closeBtn = document.getElementById('modal-close')!;
        const customForm = document.getElementById('custom-form') as HTMLFormElement;
        const modalAlert = document.getElementById('modal-alert')!;
        const submitBtn = document.getElementById('custom-submit') as HTMLButtonElement;
        const submitText = document.getElementById('custom-btn-text')!;
        const submitLoading = document.getElementById('custom-btn-loading')!;

        function openModal() {
            modal.classList.remove('hidden');
            (document.getElementById('custom-username') as HTMLInputElement).focus();
        }
        function closeModal() {
            modal.classList.add('hidden');
            modalAlert.classList.add('hidden');
            (document.getElementById('custom-username') as HTMLInputElement).value = '';
        }

        customBtn.addEventListener('click', openModal);
        closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

        customForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const username = (document.getElementById('custom-username') as HTMLInputElement).value.trim();
            const domain = domainSelect.value;

            modalAlert.classList.add('hidden');

            // Kalau username kosong → generate random (sama seperti New)
            if (!username) {
                window.location.href = '/';
                return;
            }

            submitBtn.disabled = true;
            submitText.classList.add('hidden');
            submitLoading.classList.remove('hidden');

            try {
                const res = await fetch('/api/inbox/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, domain }),
                });
                const data = await res.json();
                if (res.ok) {
                    window.location.href = `/?id=${data.id}`;
                } else {
                    modalAlert.textContent = data.error || 'Terjadi kesalahan.';
                    modalAlert.classList.remove('hidden');
                    submitBtn.disabled = false;
                    submitText.classList.remove('hidden');
                    submitLoading.classList.add('hidden');
                }
            } catch {
                modalAlert.textContent = 'Koneksi ke server gagal.';
                modalAlert.classList.remove('hidden');
                submitBtn.disabled = false;
                submitText.classList.remove('hidden');
                submitLoading.classList.add('hidden');
            }
        });

        // ── PASSWORD GATE ──
        const CORRECT_PASSWORD = 'tokosans123';
        const SESSION_KEY = 'sansmail_auth';
        const gate = document.getElementById('password-gate') as HTMLElement;
        const mainContent = document.getElementById('main-content') as HTMLElement;
        const gateForm = document.getElementById('gate-form') as HTMLFormElement;
        const gateInput = document.getElementById('gate-password') as HTMLInputElement;
        const gateError = document.getElementById('gate-error') as HTMLElement;
        const gateToggle = document.getElementById('gate-toggle') as HTMLButtonElement;

        function unlockApp() {
            gate.style.animation = 'gateOut 0.25s ease forwards';
            setTimeout(() => {
                gate.style.display = 'none';
                mainContent.classList.remove('hidden');
            }, 230);
        }

        // Cek session — kalau sudah pernah login, langsung buka
        if (sessionStorage.getItem(SESSION_KEY) === '1') {
            gate.style.display = 'none';
            mainContent.classList.remove('hidden');
        }

        gateForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const val = gateInput.value;
            if (val === CORRECT_PASSWORD) {
                sessionStorage.setItem(SESSION_KEY, '1');
                gateError.classList.add('hidden');
                unlockApp();
            } else {
                gateInput.value = '';
                gateInput.focus();
                gateError.classList.remove('hidden');
                // Reset animasi shake
                gateError.style.animation = 'none';
                gateError.offsetHeight; // reflow
                gateError.style.animation = '';
            }
        });

        // Toggle show/hide password
        gateToggle.addEventListener('click', () => {
            const isPass = gateInput.type === 'password';
            gateInput.type = isPass ? 'text' : 'password';
            gateToggle.querySelector('svg')!.innerHTML = isPass
                ? '<line x1="1" y1="1" x2="23" y2="23"></line><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>'
                : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
        });
    </script>

    <style is:global>
        @keyframes gateOut {
            from { opacity: 1; transform: scale(1); }
            to   { opacity: 0; transform: scale(1.04); }
        }
    </style>
</Layout>
