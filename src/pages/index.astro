---
import Layout from '../layouts/Layout.astro';
import { db } from '../db/index';
import { inboxes, emails, authDomains } from '../db/schema';
import { eq, desc } from 'drizzle-orm';

// Server-side logic
let currentInboxId = Astro.url.searchParams.get('id');
let currentInbox = null;
let currentEmails = [];

// Selalu fetch domain list (dibutuhkan untuk modal custom email)
const dbDomains = await db.select().from(authDomains);

if (!currentInboxId) {
    // Generate human-like email (no underscores)
    const firstNames = ['andi','budi','citra','dani','eka','fira','gita','hana','irma','joko','kiki','lina','mira','niko','oka','pita','rani','sari','tari','udin','vina','wati','yogi','zara','bayu','dewi','evan','faiz','gilang','hendra','indra','jaya','kevin','laras','maya','nadia','oscar','putri','reza','siska','tono','ulfa','vera','wira','yuda','zahra','arif','bella','ciko','dita'];
    const lastNames = ['pratama','santoso','wijaya','kusuma','rahayu','saputra','wibowo','nugroho','hidayat','setiawan','lestari','purnama','hasanah','maulana','fitriani','susanto','kurniawan','nuraini','ramadan','hartono','prastowo','andriani','mahendra','sulistyo','oktavia','permana','yuliana','fahrizal','anggraeni','suryana'];
    const fn = firstNames[Math.floor(Math.random() * firstNames.length)];
    const ln = lastNames[Math.floor(Math.random() * lastNames.length)];
    const num = Math.floor(Math.random() * 90) + 10; // 10–99
    const username = `${fn}.${ln}${num}`;
    const randomHash = Math.random().toString(36).substring(2, 10);
    // Multi-domain support (Dynamic from Database)
    const availableDomains = dbDomains.length > 0 ? dbDomains.map(d => d.name) : ["sansmail.temp"];
    const randomDomain = availableDomains[Math.floor(Math.random() * availableDomains.length)];
    const newAddress = `${username}@${randomDomain}`;
    
    await db.insert(inboxes).values({
        id: randomHash,
        email: newAddress
    });
    
    return Astro.redirect(`/?id=${randomHash}`);
} else {
    const result = await db.select().from(inboxes).where(eq(inboxes.id, currentInboxId)).limit(1);
    if (result.length > 0) {
        currentInbox = result[0];
        currentEmails = await db.select().from(emails).where(eq(emails.inboxId, currentInboxId)).orderBy(desc(emails.receivedAt));
    } else {
        return Astro.redirect(`/`);
    }
}
---

<Layout title="SansMail | Disposable Email">
    <!-- Pass domain list ke client -->
    <script type="application/json" id="domains-data" set:html={JSON.stringify(dbDomains.length > 0 ? dbDomains.map(d => d.name) : ['sansmail.temp'])}></script>

    <!-- ── PASSWORD GATE ── -->
    <div id="password-gate" class="gate-overlay">
        <div class="gate-box">
            <div class="gate-logo">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                <h1 class="gate-title">SansMail</h1>
            </div>
            <p class="gate-subtitle">Masukkan password untuk melanjutkan</p>
            <div id="gate-error" class="gate-error hidden">Password salah. Coba lagi.</div>
            <form id="gate-form" class="gate-form">
                <div class="gate-input-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="gate-input-icon"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    <input
                        type="password"
                        id="gate-password"
                        placeholder="Password"
                        class="gate-input"
                        autocomplete="current-password"
                        autofocus
                    />
                    <button type="button" id="gate-toggle" class="gate-eye-btn" title="Lihat password">
                        <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
                <button type="submit" class="gate-submit">Masuk</button>
            </form>
        </div>
    </div>

    <div id="main-content" class="page-wrapper hidden">
        <main class="container">
            <header class="header">
                <div class="logo-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    <h1 class="logo">SansMail</h1>
                </div>
                <p class="subtitle">Secure, fast, and anonymous temporary email.</p>
            </header>
            
            <section class="card address-card">
                <span class="label">Your Temporary Address</span>
                <div class="copy-group">
                    <div class="address-display">
                        <span id="email-address">{currentInbox?.email}</span>
                    </div>
                    <button type="button" class="btn-primary" id="copy-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                        Copy
                    </button>
                    <button type="button" class="btn-new" id="custom-email-btn" title="Ganti email">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                        Ganti
                    </button>
                </div>
                <div class="loading-indicator">
                    <div class="spinner"></div>
                    <span>Checking for new emails automatically...</span>
                </div>
            </section>

            <section class="card inbox-card">
                <div class="inbox-header">
                    <h2>Inbox</h2>
                    <span class="badge">{currentEmails.length}</span>
                </div>
                
                <div class="email-list">
                    {currentEmails.length === 0 ? (
                        <div class="empty-state">
                            <div class="empty-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--border-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                            </div>
                            <h3>Your inbox is empty</h3>
                            <p>Waiting for incoming messages</p>
                        </div>
                    ) : (
                        <div class="emails">
                            {currentEmails.map((msg) => (
                                <div class="email-item">
                                    <div class="email-meta">
                                        <div class="sender-info">
                                            <div class="avatar">{msg.sender.charAt(0).toUpperCase()}</div>
                                            <span class="sender">{msg.sender}</span>
                                        </div>
                                        <span class="time">Just now</span>
                                    </div>
                                    <h3 class="subject">{msg.subject || "(No Subject)"}</h3>
                                    <div class="body-content">
                                        {msg.textBody || msg.htmlBody || "No content."}
                                    </div>
                                </div>
                            ))}
                        </div>
                    )}
                </div>
            </section>
        </main>
    </div>

    <!-- Modal Ganti Email -->
    <div id="custom-modal" class="modal-overlay hidden">
        <div class="modal-box">
            <div class="modal-header">
                <h2>Ganti Email</h2>
                <button type="button" id="modal-close" class="modal-close-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            <div id="modal-alert" class="modal-alert hidden"></div>
            <form id="custom-form">
                <div class="email-builder">
                    <input
                        type="text"
                        id="custom-username"
                        placeholder="kosongkan untuk acak..."
                        class="input-username"
                        autocomplete="off"
                        spellcheck="false"
                    />
                    <span class="at-sign">@</span>
                    <select id="custom-domain" class="input-domain"></select>
                </div>
                <p class="modal-hint">Kosongkan username untuk generate email acak</p>
                <button type="submit" class="btn-modal-submit" id="custom-submit">
                    <span id="custom-btn-text">Gunakan Email Ini</span>
                    <span id="custom-btn-loading" class="hidden">
                        <svg class="spin-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                    </span>
                </button>
            </form>
        </div>
    </div>

    <style>
        /* ── Password Gate ── */
        .gate-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-base, #0f172a);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 1rem;
        }
        .gate-box {
            background: var(--bg-card, #1e293b);
            border: 1px solid var(--border-color, #334155);
            border-radius: 24px;
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 400px;
            text-align: center;
            box-shadow: 0 25px 60px rgba(0,0,0,0.5);
            animation: gateIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes gateIn {
            from { opacity: 0; transform: translateY(24px) scale(0.96); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }
        .gate-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            margin-bottom: 0.5rem;
        }
        .gate-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-main, #f1f5f9);
            letter-spacing: -0.025em;
        }
        .gate-subtitle {
            color: var(--text-muted, #94a3b8);
            font-size: 0.9rem;
            margin-bottom: 1.75rem;
        }
        .gate-error {
            background: rgba(239, 68, 68, 0.1);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.25);
            border-radius: 10px;
            padding: 0.65rem 1rem;
            font-size: 0.875rem;
            margin-bottom: 1rem;
            animation: shake 0.4s ease;
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25%       { transform: translateX(-6px); }
            75%       { transform: translateX(6px); }
        }
        .gate-form {
            display: flex;
            flex-direction: column;
            gap: 0.875rem;
        }
        .gate-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
            background: var(--bg-base, #0f172a);
            border: 1px solid var(--border-color, #334155);
            border-radius: 12px;
            padding: 0 1rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .gate-input-wrap:focus-within {
            border-color: var(--primary, #3b82f6);
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
        }
        .gate-input-icon {
            color: var(--text-muted, #94a3b8);
            flex-shrink: 0;
            margin-right: 0.5rem;
        }
        .gate-input {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-main, #f1f5f9);
            font-size: 1rem;
            font-family: 'Inter', sans-serif;
