            transition: color 0.2s;
        }
        .gate-eye-btn:hover { color: var(--text-main, #f1f5f9); }
        .gate-submit {
            width: 100%;
            background: #8b5cf6;
            color: white;
            border: none;
            border-radius: 12px;
            padding: 0.95rem;
            font-size: 1rem;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
        }
        .gate-submit:hover { background: #7c3aed; }
        .gate-submit:active { transform: scale(0.98); }

        .page-wrapper {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding: 4rem 1rem;
            width: 100%;
        }
        .container {
            width: 100%;
            max-width: 720px; /* Perfectly centered width */
        }
        
        .header {
            text-align: center;
            margin-bottom: 2.5rem;
        }
        .logo-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            margin-bottom: 0.5rem;
        }
